<?xml version="1.0" encoding="utf-8"?>
<!--
    Background for the visualizer enable/cycle button.
    Renders as a glassy neon pill: subtle fill, thin rim, soft inner vignette.
    States:
      - selected (visualizer ON)  → brighter fill + accent rim
      - pressed                    → momentary highlight flash
      - default (visualizer OFF)   → dim, almost invisible until hover/tap
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed — brief bright flash -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#66FFFFFF"/>
                    <stroke android:width="1dp" android:color="#CCFFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected (visualizer is ON) — neon-pill look -->
    <item android:state_selected="true">
        <layer-list>
            <!-- Outer glow halo -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#2200DFFF"/>
                </shape>
            </item>
            <!-- Glass fill -->
            <item
                android:top="2dp"
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="22dp"
                        android:centerX="50%"
                        android:centerY="38%"
                        android:startColor="#80000000"
                        android:centerColor="#A0050F1A"
                        android:endColor="#E0000810"/>
                    <stroke android:width="1dp" android:color="#A000E0FF"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default (visualizer is OFF) — subtle, inviting a tap -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#25000000"/>
                </shape>
            </item>
            <item
                android:top="2dp"
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="22dp"
                        android:centerX="50%"
                        android:centerY="38%"
                        android:startColor="#55000000"
                        android:centerColor="#80050510"
                        android:endColor="#B0000008"/>
                    <stroke android:width="1dp" android:color="#60AA88FF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
